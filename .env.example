# Inspired Closets Gavin prototype — set in Vercel (symphny-home) for production
INSPIRED_CLOSETS_PROTOTYPE_PASSWORD=

# Cubby — Inspired Closets Claude account (not Symphony)
INSPIRED_CLOSETS_ANTHROPIC_API_KEY=
INSPIRED_CLOSETS_ANTHROPIC_MODEL=claude-sonnet-5

# QuickBooks — Development/sandbox first, then production
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback
QUICKBOOKS_REALM_ID=
QUICKBOOKS_REFRESH_TOKEN=

# Slack — Inspired Closets workspace bot
INSPIRED_CLOSETS_SLACK_BOT_TOKEN=
INSPIRED_CLOSETS_SLACK_DEFAULT_CHANNEL=
# Optional manual map if auto-match fails: {"Frank":"U123","Des":"U456"}
INSPIRED_CLOSETS_SLACK_USER_MAP=

# Homepage chat (required for live chat)
ANTHROPIC_API_KEY=
# Optional override; defaults to the current Claude Sonnet model
ANTHROPIC_MODEL=claude-sonnet-5

# Site (production — Vercel env vars)
NEXT_PUBLIC_SITE_URL=https://symphny.xyz
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/symphonystudio/discovery

# Contact form webhook (Slack/Zapier) — optional
CONTACT_WEBHOOK_URL=

# Symphony Content Engine (Cursor SDK) — local/dev only
CURSOR_API_KEY=
CONTENT_ENGINE_REPO=https://github.com/miltonisblurrd/symphnyHome.git
