{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "predev": "test -f .next/BUILD_ID && rm -rf .next || true",
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "mcp:stdio": "tsx src/mcp/stdio-server.ts",
    "content:dry-run": "tsx scripts/content-engine-run.ts --dry-run",
    "content:next": "tsx scripts/content-engine-run.ts",
    "content:next:cloud": "tsx scripts/content-engine-run.ts --cloud",
    "content:publish-check": "tsx scripts/content-publish-check.ts",
    "content:sync-heroes": "tsx scripts/content-sync-heroes.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@clerk/nextjs": "^7.5.20",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.110.7",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "next": "15.2.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "stripe": "^22.3.2",
    "svix": "^1.97.0",
    "tesseract.js": "^5.1.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250415.0",
    "@cursor/sdk": "^1.0.17",
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.6.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.2.8",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "wrangler": "^4.11.1"
  }
}
