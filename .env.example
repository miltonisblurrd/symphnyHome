# Inspired Closets Gavin prototype — set in Vercel (symphny-home) for production
INSPIRED_CLOSETS_PROTOTYPE_PASSWORD=

# Cubby — Inspired Closets Claude account (not Symphony)
INSPIRED_CLOSETS_ANTHROPIC_API_KEY=
INSPIRED_CLOSETS_ANTHROPIC_MODEL=claude-sonnet-5

# QuickBooks — Development/sandbox first, then production
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback
QUICKBOOKS_REALM_ID=
QUICKBOOKS_REFRESH_TOKEN=

# Google Sheets — Craig ops source of truth (service account read-only)
INSPIRED_CLOSETS_GOOGLE_SHEETS_ID=
INSPIRED_CLOSETS_GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste private key from JSON; keep \\n line breaks for Vercel
INSPIRED_CLOSETS_GOOGLE_PRIVATE_KEY=
# Optional comma-separated red 2026 designer tabs. Leave blank to use built-in defaults.
# Example: REB 26,YVON 26,CISS 26,MONI 26,SUMM 26,TANIA 2026,CRAIG 2026,...
INSPIRED_CLOSETS_GOOGLE_SHEET_TABS=

# Google Calendar — Des schedule push (same SA as Sheets). Office setup:
# 1) Enable Calendar API  2) Share calendar with SA (Make changes to events)
# 3) Paste calendar id from Google Calendar settings → Integrate calendar
INSPIRED_CLOSETS_GOOGLE_CALENDAR_ID=

# Google Places + Geocoding — required for lead address autocomplete.
# Same GCP project as Sheets/Calendar. Enable Places API and Geocoding API,
# then create an API key restricted to those two APIs.
INSPIRED_CLOSETS_GOOGLE_MAPS_API_KEY=

# Stow sales-order emails from inspiredclosetslv@gmail.com (Apps Script webhook)
INSPIRED_CLOSETS_STOW_WEBHOOK_SECRET=

# Slack — Inspired Closets workspace bot
INSPIRED_CLOSETS_SLACK_BOT_TOKEN=
INSPIRED_CLOSETS_SLACK_DEFAULT_CHANNEL=
# Optional manual map if auto-match fails: {"Frank":"U123","Des":"U456"}
INSPIRED_CLOSETS_SLACK_USER_MAP=

# Homepage chat (required for live chat)
ANTHROPIC_API_KEY=
# Optional override; defaults to the current Claude Sonnet model
ANTHROPIC_MODEL=claude-sonnet-5

# Site (production — Vercel env vars)
NEXT_PUBLIC_SITE_URL=https://symphny.xyz
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/symphonystudio/discovery

# Contact form webhook (Slack/Zapier) — optional
CONTACT_WEBHOOK_URL=

# Meta Ads copilot (server only — never expose these to the browser)
# Ad account id from Business settings → Accounts → Ad accounts. Include the act_ prefix.
META_AD_ACCOUNT_ID=
# Created under Business settings → Users → System users → Generate new token. Shown once.
META_SYSTEM_USER_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/inspired-closets/ops/ads/meta/callback
META_GRAPH_API_VERSION=
META_TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
# Cheap current model for the ads analyst. Do not use gpt-6-astra.
# Leave reasoning at Luna's default so it can explain the evidence.
OPENAI_MODEL=gpt-5.6-luna

# Symphony Content Engine (Cursor SDK) — local/dev only
CURSOR_API_KEY=
CONTENT_ENGINE_REPO=https://github.com/miltonisblurrd/symphnyHome.git
